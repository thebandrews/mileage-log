# Copy to .env.local for local development. EXPO_PUBLIC_* values are baked into the app bundle,
# so never put secrets here.

# API base URL, ending in /api. Local dev server: http://localhost:7071/api
# (on a physical phone use your computer's LAN IP or a tunnel instead of localhost).
EXPO_PUBLIC_API_URL=http://localhost:7071/api

# "entra" for real sign-in, "dev" to skip sign-in against a local API running with AUTH_MODE=dev.
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_DEV_USER=ben

# Microsoft Entra ID (needed when EXPO_PUBLIC_AUTH_MODE=entra).
EXPO_PUBLIC_ENTRA_TENANT_ID=
# Client ID of the "Mileage Log App" registration (public client).
EXPO_PUBLIC_ENTRA_CLIENT_ID=
# Scope exposed by the "Mileage Log API" registration.
EXPO_PUBLIC_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user
