{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_expo/*", "/assets/*", "/.well-known/*", "*.{js,css,png,ico,json,ttf,svg,pem}"]
  },
  "mimeTypes": {
    ".pem": "application/x-pem-file"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
